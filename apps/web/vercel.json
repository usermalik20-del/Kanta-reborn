{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": []
    },
    {
      "source": "/ios-download",
      "headers": []
    },
    {
      "source": "/android",
      "headers": []
    },
    {
      "source": "/guide",
      "headers": []
    },
    {
      "source": "/features",
      "headers": []
    },
    {
      "source": "/privacy",
      "headers": []
    },
    {
      "source": "/legal",
      "headers": []
    },
    {
      "source": "/licenses",
      "headers": []
    },
    {
      "source": "/support",
      "headers": []
    },
    {
      "source": "/songbook",
      "headers": []
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/page?route=%2F"
    },
    {
      "src": "^/ios-download(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fios-download"
    },
    {
      "src": "^/android(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fandroid"
    },
    {
      "src": "^/guide(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fguide"
    },
    {
      "src": "^/features(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Ffeatures"
    },
    {
      "src": "^/privacy(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fprivacy"
    },
    {
      "src": "^/legal(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Flegal"
    },
    {
      "src": "^/licenses(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Flicenses"
    },
    {
      "src": "^/support(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fsupport"
    },
    {
      "src": "^/songbook(?:\\\\.html)?$",
      "dest": "/api/page?route=%2Fsongbook"
    },
    {
      "src": "^/index\\\\.html$",
      "dest": "/api/page?route=%2F"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "*.html"
    }
  }
}
