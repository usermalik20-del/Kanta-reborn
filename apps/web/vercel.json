{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/page?route=%2F"
    },
    {
      "src": "^/ios-download$",
      "dest": "/api/page?route=%2Fios-download"
    },
    {
      "src": "^/android$",
      "dest": "/api/page?route=%2Fandroid"
    },
    {
      "src": "^/guide$",
      "dest": "/api/page?route=%2Fguide"
    },
    {
      "src": "^/features$",
      "dest": "/api/page?route=%2Ffeatures"
    },
    {
      "src": "^/privacy$",
      "dest": "/api/page?route=%2Fprivacy"
    },
    {
      "src": "^/legal$",
      "dest": "/api/page?route=%2Flegal"
    },
    {
      "src": "^/licenses$",
      "dest": "/api/page?route=%2Flicenses"
    },
    {
      "src": "^/support$",
      "dest": "/api/page?route=%2Fsupport"
    },
    {
      "src": "^/songbook$",
      "dest": "/api/page?route=%2Fsongbook"
    },
    {
      "src": "^/index\\.html$",
      "dest": "/api/page?route=%2F"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "*.html"
    }
  }
}
