<?xml version="1.0" encoding="utf-8"?>
<!-- KANTA Splash Screen - Full-bleed image (portrait default, landscape variant via drawable-land-nodpi) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color (KANTA canvas color) beneath the image -->
    <item android:drawable="@color/kanta_canvas" />

    <!-- Full-screen splash image -->
    <item
        android:gravity="fill"
        android:drawable="@drawable/kanta_splash_image" />
</layer-list>
