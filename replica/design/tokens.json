{
  "name": "KANTA Karaoke Design Tokens",
  "description": "Design tokens for KANTA Karaoke stage overlays, extending KANTA's existing visual language. Based on KANTA iOS DesignSystem (KantaColors, KantaTypography) adapted for Android Views.",
  "colors": {
    "canvas": "#0A0614",
    "canvasTop": "#140A26",
    "canvasBottom": "#0C0618",
    "bloomPurple": "#A24BFF",
    "bloomPink": "#FF3D8B",
    "bloomCyan": "#4DE3F0",
    "surface": "#1B1030",
    "surfaceHigh": "#241540",
    "elevated": "#2A1A47",
    "primary": "#A24BFF",
    "primaryHot": "#FF3D8B",
    "violet": "#6D3BFF",
    "live": "#3DE0A8",
    "cyan": "#4DE3F0",
    "amber": "#FFB03A",
    "success": "#3DE0A8",
    "warning": "#FFB03A",
    "destructive": "#FF5A6E",
    "textPrimary": "#FFFFFF",
    "textSecondary": "#CCCCCC",
    "textTertiary": "#999999",
    "hairline": "#1A1A1A",
    "accent": "#A24BFF",
    "onAccent": "#FFFFFF",
    "backgroundVideoOverlay": "#000000CC",
    "lyricActive": "#FF3D8B",
    "lyricInactive": "#FFFFFF",
    "lyricUpcoming": "#BBBBBB",
    "countdownNumber": "#FFFFFF",
    "countdownRing": "#A24BFF",
    "scorePerfect": "#3DE0A8",
    "scoreGreat": "#4DE3F0",
    "scoreGood": "#FFB03A",
    "scoreMiss": "#FF5A6E",
    "scoreValue": "#FFFFFF",
    "adjustmentKnob": "#A24BFF",
    "adjustmentTrack": "#2A1A47",
    "keypadKey": "#1B1030",
    "keypadKeyActive": "#241540",
    "keypadKeyText": "#FFFFFF",
    "introCardBackground": "#0A0614E6",
    "introCardBorder": "#1A1A1A"
  },
  "typography": {
    "hero": { "fontFamily": "sans-serif-medium", "fontWeight": "700", "fontSize": "34sp", "lineHeight": "42sp", "letterSpacing": "0" },
    "title": { "fontFamily": "sans-serif", "fontWeight": "800", "fontSize": "27sp", "lineHeight": "34sp", "letterSpacing": "0" },
    "sectionHeader": { "fontFamily": "sans-serif", "fontWeight": "800", "fontSize": "19sp", "lineHeight": "26sp", "letterSpacing": "0" },
    "songTitle": { "fontFamily": "sans-serif", "fontWeight": "600", "fontSize": "15sp", "lineHeight": "22sp", "letterSpacing": "0" },
    "metadata": { "fontFamily": "sans-serif", "fontWeight": "500", "fontSize": "13sp", "lineHeight": "20sp", "letterSpacing": "0" },
    "caption": { "fontFamily": "sans-serif", "fontWeight": "500", "fontSize": "12sp", "lineHeight": "18sp", "letterSpacing": "0" },
    "badge": { "fontFamily": "monospace", "fontWeight": "700", "fontSize": "12sp", "lineHeight": "18sp", "letterSpacing": "0" },
    "lyricActive": { "fontFamily": "sans-serif", "fontWeight": "700", "fontSize": "24sp", "lineHeight": "36sp", "letterSpacing": "0" },
    "lyricInactive": { "fontFamily": "sans-serif", "fontWeight": "400", "fontSize": "20sp", "lineHeight": "32sp", "letterSpacing": "0" },
    "lyricUpcoming": { "fontFamily": "sans-serif", "fontWeight": "400", "fontSize": "16sp", "lineHeight": "26sp", "letterSpacing": "0" },
    "countdown": { "fontFamily": "sans-serif", "fontWeight": "800", "fontSize": "72sp", "lineHeight": "80sp", "letterSpacing": "0" },
    "scoreValue": { "fontFamily": "sans-serif", "fontWeight": "800", "fontSize": "48sp", "lineHeight": "56sp", "letterSpacing": "0" },
    "scoreLabel": { "fontFamily": "sans-serif", "fontWeight": "600", "fontSize": "14sp", "lineHeight": "20sp", "letterSpacing": "0" },
    "adjustmentLabel": { "fontFamily": "sans-serif", "fontWeight": "500", "fontSize": "12sp", "lineHeight": "18sp", "letterSpacing": "0" },
    "adjustmentValue": { "fontFamily": "sans-serif", "fontWeight": "700", "fontSize": "18sp", "lineHeight": "24sp", "letterSpacing": "0" },
    "keypad": { "fontFamily": "sans-serif", "fontWeight": "600", "fontSize": "20sp", "lineHeight": "28sp", "letterSpacing": "0" },
    "introTitle": { "fontFamily": "sans-serif", "fontWeight": "800", "fontSize": "28sp", "lineHeight": "36sp", "letterSpacing": "0" },
    "introArtist": { "fontFamily": "sans-serif", "fontWeight": "500", "fontSize": "16sp", "lineHeight": "24sp", "letterSpacing": "0" },
    "introMetadata": { "fontFamily": "sans-serif", "fontWeight": "400", "fontSize": "13sp", "lineHeight": "20sp", "letterSpacing": "0" }
  },
  "spacing": {
    "base": 4,
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 56, 64, 80, 96, 112, 128]
  },
  "radius": {
    "none": 0,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 9999
  },
  "shadows": {
    "none": "none",
    "sm": "0 1px 2px #00000040",
    "md": "0 4px 8px #00000050",
    "lg": "0 8px 24px #00000060",
    "xl": "0 16px 48px #00000070",
    "glow": "0 0 24px #A24BFF40"
  },
  "motion": {
    "fast": 150,
    "normal": 250,
    "slow": 350,
    "easeOut": "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
    "easeInOut": "cubic-bezier(0.42, 0, 0.58, 1)",
    "spring": "spring(0.5, 0.8, 0, 0)"
  },
  "pairs": [
    { "text": "textPrimary", "background": "canvas", "description": "Primary text on dark canvas" },
    { "text": "textSecondary", "background": "canvas", "description": "Secondary text on dark canvas" },
    { "text": "textTertiary", "background": "canvas", "description": "Tertiary text on dark canvas (large text only)" },
    { "text": "textPrimary", "background": "surface", "description": "Primary text on surface" },
    { "text": "textSecondary", "background": "surface", "description": "Secondary text on surface" },
    { "text": "textPrimary", "background": "surfaceHigh", "description": "Primary text on elevated surface" },
    { "text": "onAccent", "background": "accent", "description": "Text on accent buttons (large text only)" },
    { "text": "lyricActive", "background": "canvas", "description": "Active lyric line on canvas" },
    { "text": "lyricInactive", "background": "canvas", "description": "Inactive lyric line on canvas" },
    { "text": "lyricUpcoming", "background": "canvas", "description": "Upcoming lyric line on canvas (large text only)" },
    { "text": "countdownNumber", "background": "canvas", "description": "Countdown numbers on canvas" },
    { "text": "scoreValue", "background": "canvas", "description": "Score value on canvas" },
    { "text": "textPrimary", "background": "elevated", "description": "Text on elevated panels" },
    { "text": "keypadKeyText", "background": "keypadKey", "description": "Keypad key text" },
    { "text": "textPrimary", "background": "introCardBackground", "description": "Intro card text" }
  ]
}
