<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kanta_radius_md" />
            <solid android:color="#CCFF5A6E" />
        </shape>
    </item>
    <item android:state_focused="true" android:state_window_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kanta_radius_md" />
            <solid android:color="@color/karaoke_keypad_key_active" />
            <stroke android:width="2dp" android:color="@color/kanta_destructive" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kanta_radius_md" />
            <solid android:color="@color/karaoke_keypad_key" />
            <stroke android:width="1dp" android:color="@color/kanta_hairline" />
        </shape>
    </item>
</selector>
